# LiberLabs pinned toolchain. Every workflow sources this file; change it only by commit.
#
# The build toolchain comes from LiberNT/libernt-build-toolchain, installed by its
# rosbe-unix-bootstrap.sh. We pin the exact commit of that script and verify the
# downloaded script's sha256 before running it, so the toolchain a run installs is
# the one reviewed here, not whatever main points to on the day of the run.
ROSBE_BOOTSTRAP_REPO=LiberNT/libernt-build-toolchain
ROSBE_BOOTSTRAP_COMMIT=2bdf34fa70f68c3bff70820c01c7f8e052770ecc
ROSBE_BOOTSTRAP_SHA256=43034aaf82e59750ed795e92e7b17206385a415ab4c241a6518304fd94b2abc7
# Versions that script installs (informational; the sha256 above is the pin):
#   LLVM-MinGW 20261007 (ucrt), LLVM (clang/lld) 20261015, MinGW-GCC 16.2.0
ROSBE_PREFIX=$HOME/.local/opt/rosbe
# Host tools come from the ubuntu-24.04 runner image (apt): cmake, ninja-build, flex, bison,
# ccache, python3-mako, python3-yaml, python3-packaging, glslang-tools, msitools.
RUNNER_IMAGE=ubuntu-24.04
# Build configuration defaults (mirrors LiberNT .github/workflows/build.yml on leeway/main)
CMAKE_COMMON_FLAGS="-DREACTOS_TARGET_NT=0xA00 -DDIAGDATA_CHANNEL= -DLIBERNT_BUILD_UPDATE_PENDING=ON -DENABLE_CCACHE=1"
